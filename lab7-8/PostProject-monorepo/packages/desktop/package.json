{
  "name": "postproject-monorepo-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Десктопний клієнт PostProject (Electron + React) на спільному ядрі @postproject/core",
  "author": "Valentyn Kachynskyi",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
    "start": "electron .",
    "typecheck": "tsc -b",
    "test": "node --test",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@postproject/core": "*",
    "graphql": "^16.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.postproject.monorepo.desktop",
    "productName": "PostProject Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "fileStorageAdapter.js",
      "ipcHandlers.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PostProject-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PostProject-Desktop-${version}-portable.${ext}"
    }
  },
  "license": "ISC"
}
