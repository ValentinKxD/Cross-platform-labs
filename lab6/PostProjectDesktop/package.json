{
  "name": "postproject-desktop",
  "version": "1.0.0",
  "description": "PostProject Desktop — десктопна версія PostProject (Electron + React + GraphQL)",
  "main": "main.js",
  "private": true,
  "author": "Valentyn Kachynskyi",
  "license": "ISC",
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
    "start": "electron .",
    "typecheck": "tsc -b",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "graphql": "^16.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.postproject.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PostProject-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PostProject-Desktop-${version}-portable.${ext}"
    }
  }
}
