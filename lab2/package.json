{
  "name": "postproject-server",
  "version": "1.0.0",
  "description": "REST API серверної частини застосунку поштової логістики PostProject (ЛР №2, КПП)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "npm install",
    "api:get": "node scripts/testApi.js get",
    "api:post": "node scripts/testApi.js post",
    "api:getById": "node scripts/testApi.js getById",
    "api:track": "node scripts/testApi.js track",
    "api:put": "node scripts/testApi.js put",
    "api:delete": "node scripts/testApi.js delete",
    "api:invalid": "node scripts/testApi.js invalid",
    "api:all": "node scripts/testApi.js all",
    "api:seed": "node scripts/testApi.js seed"
  },
  "keywords": [
    "postproject",
    "express",
    "mongoose",
    "rest-api"
  ],
  "author": "Валентин Качинський, ВЕБ-21",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^8.19.1"
  }
}